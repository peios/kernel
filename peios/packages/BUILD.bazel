load("@rules_rust//rust:defs.bzl", "rust_binary")
load(":build.bzl", "package_assembly_test")
load(":package.bzl", "kernel_package_family", "package_store_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "build.bzl",
    "package.bzl",
    "stages.py",
    "package.py",
    "assembly.py",
    "data/COPYING",
])

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
        ],
    ) + ["//peios/packages/tests:sources"],
)

rust_binary(
    name = "check-blobs",
    srcs = ["check_blobs.rs"],
    edition = "2024",
    deps = [
        "@crates//:anyhow",
        "@crates//:sha2",
        "@crates//:zstd",
    ],
)

kernel_package_family()

package_store_test(
    name = "store-test",
    size = "small",
    srcs = [
        "assembly.py",
        "package.py",
    ] + glob(["legacy/*.toml"]),
    main = "test_store.py",
)

package_assembly_test(
    name = "assembly-test",
    size = "small",
    srcs = ["assembly.py"],
    main = "test_assembly.py",
)

package_assembly_test(
    name = "stage-test",
    size = "small",
    srcs = ["stage-kernel.py"],
    main = "test_stage.py",
)

filegroup(
    name = "tools_recipe",
    srcs = [
        "build-tools.sh",
        "runtime-shebangs.sh",
        "stages.py",
        "//peios:build-settings.json",
        "//peios:runner.py",
    ] + glob(["man/*"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "kernel_recipe",
    srcs = [
        "install-modules-irf.sh",
        "irf-modules.list",
        "runtime-shebangs.sh",
        "split-host-debug.sh",
        "stage-kernel.py",
        "stages.py",
        "//peios:build-settings.json",
        "//peios:runner.py",
    ],
    visibility = ["//visibility:public"],
)
