load("//peios:kernel.bzl", "kernel_build", "kernel_dev", "kernel_test")
load("//peios/packages:build.bzl", "kernel_content", "kernel_tools")
load("//peios/packages:package.bzl", "package_store")
load("//peios/style:rules.bzl", "local_command", "local_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = [
            ".git/**",
            "bazel-*/**",
            ".peios-dev/**",
            "peios/**",
            "BUILD.bazel",
            "MODULE.bazel*",
            ".bazel*",
            "**/__pycache__/**",
            "**/*.pyc",
        ],
    ),
)

kernel_build(
    name = "kernel",
    srcs = [":sources"],
    profile = "production",
)

kernel_build(
    name = "kernel-kunit",
    srcs = [":sources"],
    profile = "kunit",
)

kernel_dev(
    name = "kernel-dev",
    srcs = [":sources"],
)

kernel_test(
    name = "kunit",
    timeout = "long",
    kernel = ":kernel-kunit",
    tags = [
        "external",
        "no-remote",
        "no-sandbox",
    ],
)

kernel_tools(
    name = "kernel-tools",
    srcs = [":sources"],
)

kernel_content(
    name = "kernel-package-content",
    srcs = [":sources"],
    kernel = ":kernel",
)

filegroup(
    name = "package-sources",
    srcs = [
        ":sources",
        "//peios:sources",
        "//peios/packages:sources",
        "//peios/rust:sources",
        "//peios/style:sources",
        "//peios/vendor/ppk:sources",
    ] + glob([
        "BUILD.bazel",
        "MODULE.bazel*",
        ".bazel*",
    ]),
)

package_store(
    name = "packages",
    packages = ["//peios/packages:all"],
)

# All owned source plus generated inputs needed by the Cargo tests.
filegroup(
    name = "style-sources",
    srcs = glob([
        "fs/stratafs/**",
        "net/ntfe/**",
        "security/pkm/**",
        "BUILD.bazel",
        "MODULE.bazel",
        "include/linux/kacs_mntns.h",
        "include/linux/kacs_stratafs.h",
        "include/linux/peios_ntfe.h",
        "include/trace/events/kacs.h",
        "include/trace/events/kmes.h",
        "include/trace/events/lcs.h",
        "include/trace/events/stratafs.h",
        "include/uapi/pkm/access.h",
        "include/uapi/pkm/file.h",
        "include/uapi/pkm/ipc.h",
        "include/uapi/pkm/kmes.h",
        "include/uapi/pkm/lcs.h",
        "include/uapi/pkm/mntns.h",
        "include/uapi/pkm/net.h",
        "include/uapi/pkm/ntfe.h",
        "include/uapi/pkm/pkm.h",
        "include/uapi/pkm/process.h",
        "include/uapi/pkm/psb.h",
        "include/uapi/pkm/sd.h",
        "include/uapi/pkm/sid.h",
        "include/uapi/pkm/socket.h",
        "include/uapi/pkm/syscall.h",
        "include/uapi/pkm/token.h",
        "include/uapi/pkm/trace.h",
        ".clang-format",
        ".rustfmt.toml",
    ]) + [
        "//peios:style-sources",
        "//peios/packages:sources",
        "//peios/rust:sources",
        "//peios/style:sources",
    ],
)

local_test(
    name = "style",
    timeout = "moderate",
    srcs = [":style-sources"],
    command = "exec python3 peios/style.py check",
    tags = [
        "external",
        "no-remote",
        "no-sandbox",
    ],
)

local_command(
    name = "format",
    command = "exec python3 peios/style.py format",
    workspace = True,
)

local_test(
    name = "rust-core-tests",
    timeout = "moderate",
    srcs = [":style-sources"],
    command = 'export CARGO_TARGET_DIR="${TEST_TMPDIR:?}/cargo"; exec bash peios/rust/check.sh',
    tags = [
        "external",
        "no-remote",
        "no-sandbox",
    ],
)

local_command(
    name = "style-review",
    command = 'exec bash peios/style/review.sh "$@"',
    workspace = True,
)

local_test(
    name = "uapi-tests",
    size = "small",
    srcs = [":style-sources"],
    command = "bash peios/rust/peios-uapi/check-codegen-safe.sh && exec bash peios/rust/peios-uapi/check-userspace-clean.sh",
    tags = [
        "external",
        "no-remote",
        "no-sandbox",
    ],
)

# Regenerate checked-in tables explicitly; normal checks never rewrite source.
local_command(
    name = "generate-kmes-events",
    command = "exec python3 peios/gen-kmes-event-table.py",
    workspace = True,
)

local_test(
    name = "kmes-event-table-test",
    size = "small",
    srcs = [":style-sources"],
    command = "python3 peios/gen-kmes-event-table.py --check && exec python3 peios/test_kmes_event_table.py",
    tags = [
        "external",
        "no-remote",
        "no-sandbox",
    ],
)

local_test(
    name = "data-generator-tests",
    size = "small",
    srcs = [":style-sources"],
    command = "python3 peios/gen-port-reservations-seed.py --check && exec python3 peios/test_data_generators.py",
    tags = [
        "external",
        "no-remote",
        "no-sandbox",
    ],
)

local_test(
    name = "mldsa-vector-test",
    size = "small",
    srcs = [":style-sources"],
    command = "exec python3 peios/test_mldsa_vectors.py",
    tags = [
        "external",
        "no-remote",
        "no-sandbox",
    ],
)

local_test(
    name = "kunit-runner-tests",
    size = "small",
    srcs = [":style-sources"],
    command = "exec python3 peios/test_kunit_runner.py",
    tags = [
        "external",
        "no-remote",
        "no-sandbox",
    ],
)

local_test(
    name = "qualification-build-test",
    size = "small",
    srcs = [":style-sources"],
    command = "exec bash peios/qualification/check-build.sh",
    tags = [
        "external",
        "no-remote",
        "no-sandbox",
    ],
)

local_command(
    name = "generate-port-seed",
    command = "exec python3 peios/gen-port-reservations-seed.py",
    workspace = True,
)

local_command(
    name = "qualify-mntns",
    command = 'exec bash peios/qualification/test-mntns.sh "$@"',
    workspace = True,
)

local_command(
    name = "qualify-stratafs",
    command = 'exec bash peios/qualification/test-stratafs.sh "$@"',
    workspace = True,
)

local_command(
    name = "qualify-stratafs-dir-bench",
    command = 'exec bash peios/qualification/test-stratafs-dir-bench.sh "$@"',
    workspace = True,
)

local_command(
    name = "qualify-modsig",
    command = 'exec bash peios/qualification/test-modsig.sh "$@"',
    workspace = True,
)

local_command(
    name = "qualify-fwsig",
    command = 'exec bash peios/qualification/test-fwsig.sh "$@"',
    workspace = True,
)
